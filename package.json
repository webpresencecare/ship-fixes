{
  "name": "ship-fixes",
  "version": "0.2.0",
  "private": true,
  "description": "Ship Fixes: the blocks and the settings screen.",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "npm run build:blocks && npm run build:admin",
    "postbuild": "node bin/guard-build.mjs",
    "build:blocks": "wp-scripts build --webpack-src-dir=src/blocks --blocks-manifest --output-path=build/blocks",
    "build:admin": "wp-scripts build settings=./settings/index.js youtube-no-cookie=./youtube-no-cookie/index.js --webpack-src-dir=src/admin --output-path=build/admin",
    "start": "wp-scripts start --webpack-src-dir=src/blocks --blocks-manifest --output-path=build/blocks",
    "lint:js": "wp-scripts lint-js src",
    "lint:style": "wp-scripts lint-style \"src/**/*.scss\"",
    "format": "wp-scripts format src tests/e2e"
  },
  "devDependencies": {
    "@wordpress/scripts": "37.1.0"
  },
  "dependencies": {
    "@wordpress/a11y": "5.1.0",
    "@wordpress/api-fetch": "8.1.0",
    "@wordpress/block-editor": "20.0.0",
    "@wordpress/blocks": "17.1.0",
    "@wordpress/components": "44.0.0",
    "@wordpress/compose": "9.1.0",
    "@wordpress/core-data": "9.1.0",
    "@wordpress/data": "11.1.0",
    "@wordpress/dataviews": "22.0.0",
    "@wordpress/element": "10.1.0",
    "@wordpress/escape-html": "4.1.0",
    "@wordpress/i18n": "7.1.0",
    "@wordpress/icons": "20.0.0",
    "@wordpress/notices": "6.1.0",
    "@wordpress/url": "5.1.0"
  }
}
